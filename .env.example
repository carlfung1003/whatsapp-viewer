# Copy to .env.local (which is gitignored) and fill in.
#
# Required only if you want the "Summarize" AI button on chat pages.
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. When set, requests arriving via a non-localhost hostname
# (e.g. Tailscale Serve) must enter this passcode once per device.
# Direct localhost requests skip the gate.
VIEWER_PASSCODE=
